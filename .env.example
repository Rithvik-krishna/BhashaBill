# Copy to .env.local and fill in. NEVER commit real keys.

# --- Sarvam AI (https://www.sarvam.ai) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
# Verified Sarvam model defaults (run `node --env-file=.env.local scripts/smoke-services.mjs` to test)
SARVAM_STT_MODEL=saaras:v4
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads

# --- Supabase (server-side only; service role key must never reach the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Flagsmith (server-side environment key) ---
# Flags to create: reminder_templates (JSON remote config), reminder_tone_test (multivariate), tts_readback (boolean)
FLAGSMITH_ENVIRONMENT_KEY=

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# true = frontend uses mock data (no backend needed). Set false once the API routes are live.
NEXT_PUBLIC_USE_MOCKS=true
# Demo-only incident endpoint for NudgeBee. Keep false except during the demo.
ENABLE_STRESS_ENDPOINT=false
